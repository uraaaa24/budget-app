{
  "name": "budget-app",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=web --filter=backend",
    "build:web": "pnpm --filter web run build",
    "build:backend": "pnpm --filter backend run build",
    "dev": "turbo run dev --filter=web --filter=backend",
    "dev:web": "pnpm --filter web run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "deploy:backend": "pnpm --filter backend run deploy",
    "deploy:backend:ci": "gh workflow run deploy-backend.yml --ref main",
    "deploy:check": "pnpm run lint && pnpm run check-types && pnpm run build",
    "lint": "turbo run lint --filter=web --filter=backend",
    "check-types": "turbo run check-types --filter=web --filter=backend",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook",
    "db:migrate": "pnpm --filter backend run db:migrate",
    "db:studio": "pnpm --filter backend run orm:studio"
  },
  "dependencies": {
    "react-native-css-interop": "^0.2.1"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.7",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.3"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
