{
  "name": "budget-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web --filter=backend",
    "dev:mobile": "pnpm --filter mobile dev",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "setup:git-hooks": "git config core.hooksPath .githooks",
    "db:start": "colima start && pnpm supabase start -x storage-api,logflare,vector,realtime,studio,postgres-meta",
    "db:start:full": "colima start && pnpm supabase start",
    "db:stop": "pnpm supabase stop || true; colima stop || true",
    "db:status": "pnpm supabase status",
    "db:reset": "pnpm supabase db reset",
    "db:push": "pnpm supabase db push",
    "db:push:local": "pnpm supabase db push --local",
    "db:migration:new": "pnpm supabase migration new",
    "db:migrate": "pnpm db:start && pnpm db:reset",
    "db:setup": "pnpm db:start && pnpm db:reset"
  },
  "dependencies": {
    "react-native-css-interop": "^0.2.1"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "supabase": "^2.76.8",
    "turbo": "^2.8.7",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.3"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
