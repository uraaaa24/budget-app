{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["es2022"],
    "types": ["node"],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true
  },
  "include": ["src"]
}
