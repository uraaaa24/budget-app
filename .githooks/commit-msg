#!/usr/bin/env bash

set -euo pipefail

MSG_FILE="${1:-}"

if [[ -z "$MSG_FILE" || ! -f "$MSG_FILE" ]]; then
  echo "commit-msg hook: message file is missing."
  exit 1
fi

FIRST_LINE="$(head -n 1 "$MSG_FILE" | tr -d '\r')"

# Allow common auto-generated messages.
if [[ "$FIRST_LINE" =~ ^(Merge|Revert|fixup!|squash!) ]]; then
  exit 0
fi

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?(!)?: .+$'

if ! [[ "$FIRST_LINE" =~ $PATTERN ]]; then
  cat <<'EOF'
Invalid commit message format.

Use:
  <type>(optional-scope): <subject>

Examples:
  feat(mobile): add transaction summary card
  fix(backend): handle missing budget id
  chore: update workspace scripts

Allowed types:
  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
EOF
  exit 1
fi

if [[ ${#FIRST_LINE} -gt 100 ]]; then
  echo "Commit message is too long (${#FIRST_LINE}/100)."
  exit 1
fi

if [[ "$FIRST_LINE" =~ \.$ ]]; then
  echo "Commit subject must not end with a period."
  exit 1
fi
